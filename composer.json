{
    "name": "sugarcommerce/oauth",
    "version": "1.0.0",
    "description": "The two halves of an OAuth 2.0 authorization-code round trip that providers leave to you: a PKCE pair (RFC 7636, S256) and a signed state bound to a cookie in the browser that started the trip, so a callback is only honoured where it began.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/sugarcommerce/oauth",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "oauth",
        "oauth2",
        "pkce",
        "rfc7636",
        "state",
        "csrf",
        "login"
    ],
    "require": {
        "php": ">=8.5",
        "sugarcommerce/signed-tokens": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\OAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\OAuth\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/sugarcommerce/oauth/issues",
        "source": "https://github.com/sugarcommerce/oauth"
    }
}
